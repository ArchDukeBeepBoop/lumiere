<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Lumiere</string>
	<key>CFBundleDisplayName</key>
	<string>Lumiere</string>
	<key>CFBundleExecutable</key>
	<string>Lumiere</string>
	<key>CFBundleIdentifier</key>
	<string>com.lumiere.client</string>
	<!-- Both keys on purpose: CFBundleIconFile is what the Finder and Dock read
	     from a hand-assembled bundle, CFBundleIconName is what newer APIs expect.
	     The .icns is generated by Scripts/make-icon.py. -->
	<key>CFBundleIconFile</key>
	<string>Lumiere</string>
	<key>CFBundleIconName</key>
	<string>Lumiere</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.entertainment</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Jellyfin servers on a LAN are routinely plain HTTP on a local
		     hostname or IP. Arbitrary loads are limited to local networking. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lumiere discovers and connects to Jellyfin servers on your local network.</string>
</dict>
</plist>
