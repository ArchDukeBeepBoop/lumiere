<?xml version="1.0" encoding="utf-8"?>
<!-- The Quest's app: a room in passthrough with Lumiere's window placed in it
     (Meta Spatial SDK), pointed at with the controllers or hands. The window is
     MainActivity, the same as the phone's and the TV's, drawn as a panel. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">
    <!-- The library of the device's own videos and music (On This Phone). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <!-- Your room's walls from Space Setup, asked for only when you hang the screen on one;
         reading the room is done through spatial anchors, so the scene query needs both. -->
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />
    <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" />
    <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="69" horizonos:targetSdkVersion="69" />

    <application android:largeHeap="true">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />

        <!-- Lumiere's window: what the launcher opens, a normal Horizon OS window in the
             lobby, moved, resized and brought nearer with the system's own window bar. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="false"
            tools:replace="android:launchMode,android:supportsPictureInPicture">
            <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" />
        </activity>

        <!-- The theater: started by Play, a film round you in the place you chose, back to the
             window when it ends. Not in the launcher. -->
        <activity
            android:name="app.lumiere.android.spatial.LumiereSpace"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>

        <!-- The film's host inside the theater (TheaterWindow): embedded in its panel, never a
             task of its own. Horizon OS refuses a single-task, non-embeddable activity on a
             panel's display (Permission Denial). -->
        <activity
            android:name="app.lumiere.android.spatial.TheaterWindow"
            android:allowEmbedded="true"
            android:exported="false"
            android:launchMode="standard"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
    </application>
</manifest>
